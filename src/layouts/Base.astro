---
import '../styles/global.css';
interface Props { title: string; description?: string; nav?: string; noindex?: boolean }
const { title, description, nav = '', noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(path, Astro.site).href;
const links = [
  ['accueil', '/', 'Accueil'],
  ['mannequins', '/test-mannequin-tejay', 'Mannequins'],
  ['guides', '/remplir-mannequin-grappling', 'Guides'],
  ['apropos', '/mentions-legales', 'À propos'],
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Dojo Maison">
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  <meta property="og:url" content={canonical}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=JetBrains+Mono:wght@500&family=Source+Sans+3:wght@400;600;700&display=swap">
  <slot name="head" />
</head>
<body>
<header class="site-head">
  <div class="wrap">
    <a class="logo" href="/"><span class="logo-belt" aria-hidden="true"></span>Dojo Maison</a>
    <nav class="nav" aria-label="Menu principal">
      {links.map(([key, href, label]) => <a href={href} aria-current={nav === key ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<div class="disclosure"><div class="wrap">En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises.</div></div>
<main><slot /></main>
<footer class="site-foot">
  <div class="wrap">
    <a class="logo" href="/"><span class="logo-belt" aria-hidden="true"></span>Dojo Maison</a>
    <p>En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises. Cela ne change pas le prix que tu paies.</p>
    <div class="foot-links">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/mentions-legales#affiliation">Liens partenaires</a>
    </div>
  </div>
</footer>
</body>
</html>
